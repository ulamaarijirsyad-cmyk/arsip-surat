# ---- Konfigurasi SI-ARSIP ----
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env yang berisi nilai nyata.

# Port server Express (API + static build).
PORT=3001

# Koneksi PostgreSQL (dipakai mulai Phase 2).
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DB
# Isi di file .env (bukan di sini). Bila password mengandung karakter
# khusus (@ : / # ? %), encode dengan URL-encoding.
# HOST: alamat server PostgreSQL (LAN) atau host cloud.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/siarsip

# Maksimum koneksi dalam pool PostgreSQL.
DB_POOL_MAX=10

# Batas waktu membuat koneksi baru (milidetik).
DB_CONNECTION_TIMEOUT_MS=5000

# 'true' bila PostgreSQL mewajibkan SSL (umumnya cloud). 'false' untuk LAN.
DB_SSL=false

# Secret untuk menandatangani cookie session (Phase 2C: authentication).
# WAJIB minimal 32 karakter. Buat sendiri, misalnya PowerShell:
#   [Convert]::ToBase64String((New-Object Byte[] 48 | ForEach-Object { Get-Random -Maximum 256 }))
# JANGAN tulis nilai nyata di file ini — isi di .env lokal.
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Umur maksimum session login (detik). Default 8 jam.
SESSION_MAX_AGE_SECONDS=28800

# Rate limit khusus endpoint login (POST /api/auth/login).
# Jumlah percobaan maksimal per jendela waktu (ms). Default: 10 per 15 menit.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Cost factor bcrypt untuk hashing password (semakin besar = semakin aman,
# tetapi semakin lambat). Default: 10.
BCRYPT_ROUNDS=10

# Jenis penyimpanan file: local | s3
# 'local' = folder di disk server (LAN), 's3' = object storage (cloud).
STORAGE_TYPE=local

# Folder penyimpanan file bila STORAGE_TYPE=local.
# Gunakan path absolut yang sesuai mesin server (bukan C:\Users\...).
STORAGE_DIR=/var/lib/siarsip/documents

# Batas ukuran SATU file lampiran saat upload, dalam megabait (Phase 2E-2).
# Diizinkan: PDF, JPG/JPEG, PNG. Default bila tidak diisi: 5.
MAX_UPLOAD_MB=5

# 'true' bila aplikasi diakses via HTTPS (cloud). 'false' untuk LAN HTTP.
COOKIE_SECURE=false

# Aktifkan endpoint test RBAC (Phase 2C-3): /api/_test/rbac/*.
# HANYA untuk pengujian lokal — JANGAN diaktifkan di produksi.
RBAC_TEST_ROUTES=false
